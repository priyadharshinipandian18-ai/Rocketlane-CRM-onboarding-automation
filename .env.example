# --- LLM: classifies the email and parses the deal (API-key based) ---
# groq = hosted Llama (default) | gemini
LLM_PROVIDER=groq
# Groq: key from https://console.groq.com/keys ; GROQ_MODEL is a model ID (lowercase, hyphens, no spaces)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (only when LLM_PROVIDER=gemini): GEMINI_MODEL is a model ID, not the display name
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Retries the client makes on 429/5xx, our own attempts around a call, and the per-request timeout
LLM_MAX_RETRIES=2
LLM_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=60

# --- Gmail OAuth2 (installed-app flow) — the AE/CS-team inbox being watched ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_MAILBOX_EMAIL=cs-team@yourcompany.com

# --- Google Cloud Pub/Sub (Gmail push notifications land here) ---
GCP_PROJECT_ID=
# Topic Gmail's watch() request publishes to, e.g. projects/<project>/topics/gmail-deal-notifications
GMAIL_WATCH_TOPIC=
# Subscription the pull-runner reads from (local dev) / the Cloud Function is triggered by (deployed)
PUBSUB_SUBSCRIPTION=deal-intake-sub
# Only analyse mail sent by an active AE in app.account_executives (saves LLM calls).
# Set to false to analyse every email — e.g. when testing from a non-AE address.
REQUIRE_AE_SENDER=true
# Pull Gmail notifications inside the app process (local dev; replaces running
# scripts/run_pubsub_pull_locally.py as a second process). Needs GCP credentials.
PUBSUB_PULL_ENABLED=false
# Shared secret for POST /pubsub/push?token=... (empty = that endpoint is disabled)
PUBSUB_PUSH_TOKEN=

# --- Postgres: both the app.* tables (db/schema.sql) and the LangGraph ---
# --- checkpointer live here. Local dev: docker run -d -p 5432:5432 --name postgres \
#     -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres postgres
POSTGRES_URI=postgresql://postgres:postgres@127.0.0.1:5432/onboarding_automation

# Public base URL of this app (ngrok URL in local dev: ngrok http 8000).
# The Bolna agent's webhook must be: <WEBHOOK_BASE_URL>/webhooks/bolna?token=<BOLNA_WEBHOOK_TOKEN>
WEBHOOK_BASE_URL=http://localhost:8000

# --- Voice AI (Bolna) — "call the AE to confirm Enterprise vs Growth" step ---
# Set up the agent first: docs/bolna_agent_setup.md
BOLNA_API_KEY=bn-8eb9f302aa074ef7916535d81be6c89c
BOLNA_AGENT_ID=bbf88b32-97a5-4e85-a79c-4cea3eee7832
BOLNA_API_BASE=https://api.bolna.ai
# Optional: leave empty to use Bolna's default (+91) numbers
BOLNA_FROM_PHONE_NUMBER=
# Any long random string; also goes in the agent's webhook URL as ?token=...
BOLNA_WEBHOOK_TOKEN=
# Optional: comma-separated Bolna webhook IPs to accept (empty = not enforced)
BOLNA_ALLOWED_IPS=
# Extraction confidence below this = tier not confirmed
BOLNA_MIN_CONFIDENCE=0.7
# If Bolna returns no extractions (none configured on the agent), read the plan from the call transcript
# instead — strictly: the AE stated it, the assistant read it back, the AE's next turn affirmed it.
BOLNA_TRANSCRIPT_FALLBACK=true

# --- Plan-tier call retry policy ---
VOICE_MAX_ATTEMPTS=3
VOICE_RETRY_DELAY_MINUTES=30
# Demo: call again 5 seconds after an unanswered call (overrides the minutes above); pair with RETRY_POLL_SECONDS=5
# VOICE_RETRY_DELAY_SECONDS=5
# Only call the AE between these local hours (AE timezone from app.account_executives)
VOICE_CALL_WINDOW_START_HOUR=9
VOICE_CALL_WINDOW_END_HOUR=19
RETRY_POLL_SECONDS=60

# --- Manual tier override (POST /onboardings/{id}/plan-tier, header X-Admin-Token) ---
ADMIN_API_TOKEN=

# --- Rocketlane ---
# Slack agent: tool retry for temporary Slack failures, and the cap on LLM turns
# SLACK_TOOL_RETRY_ATTEMPTS=3
# SLACK_TOOL_RETRY_BASE_SECONDS=1
# COMMUNICATION_AGENT_MAX_STEPS=14
ROCKETLANE_ENABLED=true
ROCKETLANE_TIMEOUT_SECONDS=180ROCKETLANE_API_KEY=
ROCKETLANE_BASE_URL=https://api.rocketlane.com/api/1.0

# --- Slack (communication agent: shared customer channel) ---
# Bot token (xoxb-…) with scopes: channels:manage (groups:write if private),
# chat:write, conversations.connect:write. Empty = Slack step is skipped.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IS_PRIVATE=true
